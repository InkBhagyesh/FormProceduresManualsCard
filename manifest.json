{
	"_version": "1.15.0",
	"sap.app": {
		"id": "com.winslow.FormsProceduresCard",
		"type": "card",
		"title": "Forms and Procedures",
		"subTitle": "",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"phone": true,
			"tablet": true
		},
		"icons": {
			"icon": "sap-icon://bus-public-transport"
		}
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "com.winslow.FormsProceduresCard.View",
