<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    controllerName="com.winslow.FormsProceduresCard.Card"
    width="100%" busyIndicatorDelay="0">
  
  <VBox class="sapUiMediumMargin">

    <!-- Top: Search (Left aligned) -->
    <SearchField
        placeholder="Forms, Procedures And Manuals"
        search="onSearch"
        class="sapUiSmallMarginBottom" />

    <!-- Bottom: Title + Buttons (Right aligned) -->
<HBox
    width="100%"
    alignItems="Start"
 >

    <!-- Title -->
    <VBox >
    <Title text="POPULAR SEARCHES" level="H5" class="sapUiTinyMarginBottom"/>

    <!-- Buttons -->
    <HBox
        wrap="Wrap"
        class="popularSearchButtons sapUiSmallMarginBegin">
        <Button text="PERMIT TO WORK" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
        <Button text="CONFINED SPACE" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
        <Button text="SWMS" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
        <Button text="SEWER TECH" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
        <Button text="WATER TECH" class="sapUiTinyMarginBottom"/>
    </HBox>
</VBox>
</HBox>




    <Toolbar design="Transparent"></Toolbar>
   
    <layout:Grid defaultSpan="L4 M6 S12" hSpacing="2" vSpacing="2">

      <FlexBox direction="Row" alignItems="Center" class="sapUiSmallMargin">
        <Image press="onImagePress" src="{images>/Image_1}" alt="Confined Space" width="60px" height="60px" class="sapUiTinyMarginEnd"/>
        <Link text="Confined Space" press="onImagePress" wrapping="true" />
      </FlexBox>

      <FlexBox direction="Row" alignItems="Center" class="sapUiSmallMargin">
        <Image press="onImagePress" src="{images>/Image_2}" alt="Permit to Work" width="60px" height="60px" class="sapUiTinyMarginEnd"/>
        <Link text="Permit to Work" press="onImagePress" wrapping="true" />
      </FlexBox>

      <FlexBox direction="Row" alignItems="Center" class="sapUiSmallMargin">
        <Image press="onImagePress" src="{images>/Image_3}" alt="Sewer Tech" width="60px" height="60px" class="sapUiTinyMarginEnd"/>
        <Link text="Sewer Tech" press="onImagePress" wrapping="true" />
      </FlexBox>

      <FlexBox direction="Row" alignItems="Center" class="sapUiSmallMargin">
        <Image press="onImagePress" src="{images>/Image_4}" alt="Water Tech" width="60px" height="60px" class="sapUiTinyMarginEnd"/>
        <Link text="Water Tech"  press="onImagePress"  wrapping="true" />
      </FlexBox>

      <FlexBox direction="Row" alignItems="Center" class="sapUiSmallMargin">
        <Image press="onImagePress" src="{images>/Image_5}" alt="Mobile Plant" width="60px" height="60px" class="sapUiTinyMarginEnd"/>
        <Link text="Mobile Plant" press="onImagePress" wrapping="true" />
      </FlexBox>

      <FlexBox direction="Row" alignItems="Center" class="sapUiSmallMargin">
        <Image press="onImagePress" src="{images>/Image_6}" alt="Excavation and Trenching" width="60px" height="60px" class="sapUiTinyMarginEnd"/>
        <Link text="Excavation and Trenching" press="onImagePress" wrapping="true" />
      </FlexBox>

      <FlexBox direction="Row" alignItems="Center" class="sapUiSmallMargin">
        <Image press="onImagePress" src="{images>/Image_7}" alt="Craning and Lifting" width="60px" height="60px" class="sapUiTinyMarginEnd"/>
        <Link text="Craning and Lifting" press="onImagePress" wrapping="true" />
      </FlexBox>

      <FlexBox direction="Row" alignItems="Center" class="sapUiSmallMargin">
        <Image press="onImagePress" src="{images>/Image_8}" alt="SWMS" width="60px" height="60px" class="sapUiTinyMarginEnd"/>
        <Link text="SWMS" press="onImagePress" wrapping="true" />
      </FlexBox>

      <FlexBox direction="Row" alignItems="Center" class="sapUiSmallMargin">
        <Image press="onImagePress" src="{images>/Image_9}" alt="Product Handling" width="60px" height="60px" class="sapUiTinyMarginEnd"/>
        <Link text="Product Handling" press="onImagePress" wrapping="true" />
      </FlexBox>
    </layout:Grid>
  </VBox>
</mvc:View>
